# Application
NODE_ENV=development
PORT=3000

# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/medalign

# JWT
JWT_SECRET=your-super-secret-jwt-signing-key-must-be-at-least-32-chars
JWT_EXPIRY_MINUTES=60

# Encryption (base64-encoded 32-byte key; generate with: openssl rand -base64 32)
ENCRYPTION_KEY=VZbmMdiVnQiIQXt1jRimhBt1UWe5anTdyMtcxJzJ6UM=

# SendGrid
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@medalign.com

# App
APP_BASE_URL=http://localhost:3000
# Comma-separated list of allowed frontend origins, e.g.
# FRONTEND_ORIGIN=https://app.medalign.com,https://staging.medalign.com
FRONTEND_ORIGIN=http://localhost:5173

# Cookie domain (optional, e.g. .medalign.com in prod)
# COOKIE_DOMAIN=

# Claim token HMAC secret (generate: openssl rand -hex 32)
CLAIM_TOKEN_SECRET=your-claim-token-secret-must-be-at-least-32-chars

# Supabase Storage (clinic portal media uploads via signed URLs)
# SUPABASE_URL: your project URL, e.g. https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: service-role key (server-side only, never exposed to clients)
# SUPABASE_STORAGE_BUCKET: public-read bucket for clinic logos/photos (default: clinic-media)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=clinic-media

# Stripe (billing) — this must be a test-mode secret key (sk_test_...); never use a live key locally
STRIPE_SECRET_KEY=sk_test_placeholder

# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Shared secret for the external cron that triggers billing jobs
# (POST /admin/jobs/run/:jobName via the X-Job-Secret header)
JOB_TRIGGER_SECRET=change-me

# Calendly OAuth app (scheduling integration)
# CALENDLY_CLIENT_ID / CALENDLY_CLIENT_SECRET: from the Calendly developer app
# CALENDLY_REDIRECT_URI: Calendly OAuth redirect, the FRONTEND callback page, which relays the code to POST /clinic/portal/scheduling/calendly/callback
# CALENDLY_WEBHOOK_URL: this backend's Calendly webhook receiver URL
# CALENDLY_API_BASE / CALENDLY_AUTH_BASE: only override for testing against a mock
CALENDLY_CLIENT_ID=your-calendly-client-id
CALENDLY_CLIENT_SECRET=your-calendly-client-secret
CALENDLY_REDIRECT_URI=http://localhost:5173/clinic/portal/scheduling/callback
CALENDLY_WEBHOOK_URL=http://localhost:3000/scheduling/calendly/webhook
CALENDLY_API_BASE=https://api.calendly.com
CALENDLY_AUTH_BASE=https://auth.calendly.com
